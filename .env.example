# Copy this file to .env and fill in your own values.
# Never commit your real .env file or private key to GitHub.

# Get a free RPC URL from https://infura.io or https://alchemy.com (Sepolia network)
SEPOLIA_RPC_URL=

# Export this from MetaMask (Account Details -> Show Private Key).
# Use a TEST wallet only, never your main wallet.
PRIVATE_KEY=
